# deh-duplicate configuration template.
# Copy to `.env` and adjust as needed. Action flags (--delete and --dry-run)
# are CLI-only; other settings may also be supplied through the environment.

#
# Every variable this project reads is namespaced with DEH_ (bare names like
# MODE/VERBOSE/THRESHOLD collide with shell, CI and other projects). The names
# live in src/deh/config.py.

# Perceptual hash threshold percentage (0-100) for hash/hybrid modes. Default: 75
DEH_DUPLICATE_THRESHOLD=75

# Comparison mode: hash | deep | hybrid (default). Hybrid compares all pairs
# with deep features, then verifies deep matches with perceptual hashes.
DEH_DUPLICATE_MODE=hybrid

# Deep similarity threshold percentage in deep/hybrid modes (0-100). Default: 82
DEH_DUPLICATE_DEEP_THRESHOLD=82

# Enable detailed output ('true'/'false')
DEH_DUPLICATE_VERBOSE=false

# Silence library output -- the [Hash]/[Features]/[Quality]/[Quarantine] lines
# a module prints when its caller passed no log_cb ('true'/'false'). The CLI's
# own banner, the summary, and device alarms (GPU fallback) stay visible.
# Default: false
DEH_QUIET=false

# --- GUI display options (approval/review dialogs) -----------------------
# Dialogs always open large and centered on the primary monitor (on a
# multi-monitor desk: whichever output is marked `xrandr --primary`).
# Exact centering needs X11 (or `QT_QPA_PLATFORM=xcb` on Wayland) and a WM that
# honours the ICCCM hints (platform notes in CONTRIBUTING.md, GUI section).

# Enlarge the dialog/cards by this factor (>= 1.0). Recommended: 1.2 - 1.6
DEH_GUI_SCALE=1.4

# Collapse byte-for-byte identical files before similarity comparison ('true'/'false'). Default: true
DEH_DUPLICATE_IDENTICAL_DEDUPE=true

# --- machine budget knobs (parallelism planner, `--machine` prints its plan) --
# Hard cap on the RAM (MB) a stage may plan against, and cores kept free for
# the desktop. Both are ceilings, never floors: the planner stays under them.
# DEH_MAX_RAM_MB=16384
# DEH_CPU_RESERVE=2

# Per-stage overrides, where <PREFIX> is the stage's own prefix
# (PHASH_DECODE, FEATURES_DECODE, QUALITY_METRICS, QUALITY_CROPS):
# <PREFIX>_WORKERS pins the worker count and <PREFIX>_CHUNK the wave size -
# both are clamped to the ceilings above, and the clamp is printed in verbose mode.
# FEATURES_DECODE_WORKERS=8
